                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.95, 0.8, 0.1)
                    float inputs:roughness = 0.5
                    token outputs:surface
                }
            }

            def Material "mark_turn"
            {
                token outputs:surface.connect = </World/store/looks/mark_turn/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.95, 0.45, 0.1)
                    float inputs:roughness = 0.5
                    token outputs:surface
                }
            }
        }

