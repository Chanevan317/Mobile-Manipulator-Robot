#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "physicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom uint physxScene:timeStepsPerSecond = 240
    }

    def Xform "store"
    {
        def "looks"
        {
            def Material "wall"
            {
                token outputs:surface.connect = </World/store/looks/wall/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.86, 0.85, 0.82)
                    float inputs:roughness = 0.8
                    token outputs:surface
                }
            }

            def Material "floor"
            {
                token outputs:surface.connect = </World/store/looks/floor/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.55, 0.53)
                    float inputs:roughness = 0.6
                    token outputs:surface
                }
            }

            def Material "mark_home"
            {
                token outputs:surface.connect = </World/store/looks/mark_home/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.1, 0.35, 0.95)
                    float inputs:roughness = 0.5
                    token outputs:surface
                }
            }

            def Material "mark_task"
            {
                token outputs:surface.connect = </World/store/looks/mark_task/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
